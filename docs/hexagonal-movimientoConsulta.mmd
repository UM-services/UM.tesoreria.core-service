---
title: Arquitectura Hexagonal - MovimientoConsulta (v12.12.0)
---
flowchart TD
    subgraph Dominio ["Dominio (Domain)"]
        LD[LibroDiario<br/>asientos y totales del rango]
        AD[AsientoDiario<br/>fecha, orden, líneas y totales]
        LN[LineaDiario<br/>línea con nombres resueltos]
        RC[RangoContable<br/>día de calendario recibido]
        UCP[ConsultarLibroDiarioUseCase<br/>Puerto de Entrada]
        UCA[ConsultarAsientoUseCase<br/>Puerto de Entrada]
    end

    subgraph Aplicacion ["Aplicación (Application)"]
        Svc[MovimientoConsultaService<br/>Servicio de Aplicación]
        UC1[ConsultarLibroDiarioUseCaseImpl]
        UC2[ConsultarAsientoUseCaseImpl<br/>líneas de movcon por fecha y orden]
        ARM[ArmadoAsientos<br/>nombres resueltos, agrupar y sumar]
        TOP[TopeMovimientos<br/>max-lineas y max-dias]
        EX[MovimientoConsultaException<br/>FECHAS_REQUERIDAS, FECHA_FUERA_DE_RANGO, CUERPO_INVALIDO, PARAMETRO_INVALIDO,<br/>DESDE_POSTERIOR, RANGO_DEMASIADO_LARGO, DEMASIADOS_MOVIMIENTOS,<br/>ORDEN_INVALIDO, ASIENTO_INEXISTENTE]
    end

    subgraph Otros ["Servicios de otros slices"]
        CMS[CuentaMovimientoService<br/>contable/cuentaMovimiento]
        CS[CuentaService<br/>contable/cuenta]
        COS[ComprobanteService<br/>comprobante]
        PS[ProveedorService<br/>compras/proveedor]
    end

    subgraph Infraestructura ["Infraestructura (Infrastructure)"]
        CC[MovimientoConsultaController<br/>POST /movimientoConsulta/libroDiario<br/>GET /movimientoConsulta/asiento/{fecha}/{orden}]
        EH[MovimientoConsultaExceptionHandler<br/>400, 404 y 409, también cuerpo o parámetro ilegible]
        DM[MovimientoConsultaDtoMapper]
        Req[RangoFechasRequest<br/>desde y hasta sin pasar a UTC]
        Resp[LibroDiarioResponse<br/>AsientoDiarioResponse, LineaDiarioResponse]
        Err[MovimientoConsultaErrorResponse<br/>status, error, codigo, message]
    end

    CC -->|usa| Svc
    CC -->|recibe| Req
    CC -->|envía| Resp
    CC -->|usa| DM
    EH -->|envía| Err
    EH -->|traduce| EX

    Svc -->|ejecuta| UCP
    UC1 -->|implementa| UCP
    UC1 -->|usa| RC
    UC1 -->|usa| TOP
    UC1 -->|lanza| EX
    UC1 -->|cuenta y lee hasta tope + 1| CMS
    UC1 -->|arma asientos| ARM
    UC1 -->|produce| LD
    Svc -->|ejecuta| UCA
    UC2 -->|implementa| UCA
    UC2 -->|usa| RC
    UC2 -->|lanza| EX
    UC2 -->|líneas del asiento| CMS
    UC2 -->|arma el asiento| ARM
    UC2 -->|produce| AD
    ARM -->|nombres de cuenta| CS
    ARM -->|descripción de comprobante| COS
    ARM -->|razón social por id| PS
    LD -->|contiene| AD
    AD -->|contiene| LN

    DM -->|convierte| LD
    DM -->|convierte| Resp

