            << enum >>
            OK
            NO_ENCONTRADA
            SIN_ALTERNATIVA
            DUPLICADA
            RECHAZADA
        }
        class CanalImportacion {
            << enum >>
            PMC
            RAPIPAGO
            PAY_PER_TIC
            PAGAR
            CLICK_PAGOS
            DEBITO_DIRECTO
            DEBITO_VISA
            +getTipoPagoIds() Set~Integer~
            +isPorPeriodo() boolean
        }
        class ArchivoImportado {
            +Integer id
            +String nombre
            +OffsetDateTime fecha
            +Integer registros
        }
        class ArchivoBanco {
