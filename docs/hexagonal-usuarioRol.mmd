flowchart TD
    subgraph Dominio ["Dominio (Domain)"]
        M["UsuarioRol<br/>userId, rolId, rol"]
        IN["CreateUsuarioRolUseCase<br/>GetUsuarioRolesByUserIdUseCase<br/>DeleteUsuarioRolUseCase"]
        OUT["UsuarioRolRepository<br/>(Puerto de Salida)"]
    end

    subgraph Aplicacion ["Aplicación (Application)"]
        Svc["UsuarioRolService"]
        UCs["*UseCaseImpl<br/>alta idempotente"]
        Exc["UsuarioRolException"]
    end

    subgraph Infraestructura ["Infraestructura (Infrastructure)"]
        Ctrl["UsuarioRolController<br/>/api/tesoreria/core/usuarioRol"]
        DTO["UsuarioRolRequest<br/>UsuarioRolResponse"]
        Map["UsuarioRolDtoMapper<br/>UsuarioRolMapper"]
        Adp["JpaUsuarioRolRepositoryAdapter"]
        Ent["UsuarioRolEntity<br/>tabla usuario_rol"]
        Jpa["JpaUsuarioRolRepository"]
    end

    subgraph CrossSlice ["Puertos de entrada de otros slices"]
        Usu["GetUsuarioByIdUseCase<br/>(usuarios/usuario)"]
        Rol["GetRolByIdUseCase<br/>(usuarios/rol)"]
    end

