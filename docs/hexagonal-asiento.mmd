---
title: Arquitectura Hexagonal - Asiento (secuencia de orden contable)
---
flowchart TD
    subgraph Dominio ["Dominio (Domain)"]
        M["AsientoSecuencia<br/>(último orden por fecha)"]
        IN["ExistsAsientoByFechaBetweenUseCase<br/>ReservarOrdenContableUseCase<br/>(Puertos de Entrada)"]
        OUT["AsientoRepository<br/>AsientoSecuenciaRepository<br/>AsientoOrdenMaximoRepository<br/>(Puertos de Salida)"]
    end

    subgraph Aplicacion ["Aplicación (Application)"]
        S["AsientoService"]
        R["ReservarOrdenContableUseCaseImpl<br/>REQUIRES_NEW + reintento"]
        E["AsientoException<br/>AsientoSecuenciaException"]
    end

    subgraph Infraestructura ["Infraestructura (Infrastructure)"]
        Repo["JpaAsientoRepository"]
        Ent["AsientoEntity"]
        AdpSec["JpaAsientoSecuenciaRepositoryAdapter"]
        RepoSec["JpaAsientoSecuenciaRepository<br/>@Lock PESSIMISTIC_WRITE"]
        EntSec["AsientoSecuenciaEntity"]
        Max["JdbcAsientoOrdenMaximoRepositoryAdapter<br/>asiento + movcon + ingreso_asiento + valores"]
        Tabla["contable_asiento_secuencia<br/>docs/sql/V431"]
    end

    subgraph Externa ["Módulos Externos"]
        CS["ContabilidadService<br/>(nextAsiento delega)"]
        CO["CostoService<br/>CompraService<br/>AsientoIngreso"]
    end

    CS --> R
    CO --> R
    CS --> S
    CO --> S
    R --> OUT
    S --> Repo
    Repo --> Ent
    AdpSec --> OUT
    AdpSec --> RepoSec
    RepoSec --> EntSec
    EntSec --> Tabla
    Max --> OUT
    S -.->|"lanza"| E
    R -.->|"lanza"| E

