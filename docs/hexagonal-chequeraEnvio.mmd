---
title: Arquitectura Hexagonal - Módulo EnvioChequeras (v13.0.0)
---

classDiagram
    direction TB

    %% Envío masivo de chequeras por facultad y sede (ex formulario de Escritorio "Envío de
    %% Chequeras por Sede"). Un job por operación (CAPTURAR_CORREOS, EXTENDER_DEBITOS, MAILING)
    %% sobre el padrón de altas de un lectivo + facultad + sede. Por fila: si el domicilio no
    %% tiene ningún correo válido se omite; si ya fue enviada se corta como YA_ENVIADA; en
    %% cualquier otro caso se envía la chequera (la deuda de la persona no interviene).
    %% El envío real lo confirma tesoreria-sender por notificacion-resultado (CHEQUERA/id).

    namespace domain {
        class ChequeraEnvioAlta {
            << record >>
            +Long chequeraId
            +Integer facultadId
            +Integer tipoChequeraId
            +Long chequeraSerieId
            +Integer alternativaId
            +BigDecimal personaId
            +Integer documentoId
            +Integer lectivoId
            +Integer geograficaId
            +String apellido
            +String nombre
            +String tipoChequera
            +String arancelTipo
            +String emailPersonal
            +String emailInstitucional
            +boolean emailPersonalValido
            +boolean emailInstitucionalValido
            +boolean enviado
            +apellidoNombre() String
            +numero() String
            +hayCorreoValido() boolean
        }

        class EnvioJob {
            +Long jobId
            +EnvioOperacion operacion
            +Integer lectivoId
            +Integer facultadId
            +Integer geograficaId
            +boolean soloNoEnviadas
            +boolean codigoBarras
            +EnvioJobEstado estado
            +int totalTareas
            +int tareasOk
            +int tareasOmitidas
            +int tareasError
            +int tareasPendientes
            +String usuarioLogin
        }

        class EnvioJobTarea {
            +Long tareaId
            +Long chequeraId
            +BigDecimal personaId
            +String personaNombre
            +EnvioTareaEstado estado
            +String codigo
            +String mensaje
            +String detalle
            +Boolean retenida
            +Boolean enviado
        }

        class FiltroEnvio {
            +EnvioOperacion operacion
            +Integer lectivoId
            +Integer facultadId
            +Integer geograficaId
            +boolean soloNoEnviadas
            +List~Long~ chequeraIds
            +boolean codigoBarras
        }

        class ResultadoEnvio {
            +EnvioTareaEstado estado
            +String codigo
            +String mensaje
            +String detalle
            +Boolean retenida
            +Boolean enviado
        }

        class EnvioOperacion {
            << enumeration >>
            CAPTURAR_CORREOS
            EXTENDER_DEBITOS
            MAILING
        }

        class EnvioJobEstado {
            << enumeration >>
            PENDIENTE
            EN_PROCESO
            COMPLETADO
            CANCELADO
            ERROR
        }

        class EnvioTareaEstado {
            << enumeration >>
            PENDIENTE
            ENCOLADA
            ENVIADA
            ERROR_SMTP
            RETENIDA
            SIN_CORREOS
            CORREO_CAPTURADO
            DEBITO_EXTENDIDO
            OMITIDA
            ERROR
        }

        class EnvioSolicitud {
            +UUID solicitudId
            +Long chequeraId
            +Integer facultadId
            +Integer tipoChequeraId
            +Long chequeraSerieId
            +Integer lectivoId
            +Long jobId
            +String origen
            +String dedupeKey
            +EnvioSolicitudEstado estado
            +int intentos
            +OffsetDateTime lockHasta
            +OffsetDateTime enviadoAt
            +String ultimoError
        }

        class EnvioSolicitudClaim {
            << record >>
            +EnvioSolicitud solicitud
            +boolean puedeEnviar
            +String motivo
        }

        class EnvioSolicitudCreacion {
            << record >>
            +EnvioSolicitud solicitud
            +boolean publicar
        }

        class EnvioSolicitudEstado {
            << enumeration >>
            PENDIENTE
            ENVIANDO
            ENVIADO
            FALLIDO
            OMITIDA
            SIN_CORREOS
            SIN_CUOTAS
            RETENIDA
        }
    }

