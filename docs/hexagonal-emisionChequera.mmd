---
title: Arquitectura Hexagonal - Módulo EmisionChequera (v12.11.0)
---
flowchart TD
    subgraph Dominio ["Dominio (Domain)"]
        M["BorradorChequera<br/>BorradorCuota<br/>BorradorImpresion<br/>BorradorSede<br/>EstadoBorrador<br/>ContextoEmision<br/>SolicitudEmision<br/>ResultadoEmision"]
        MI["IncompletasJob<br/>IncompletasJobTarea<br/>IncompletasJobDetalle<br/>IncompletasEtapa<br/>IncompletasJobEstado<br/>IncompletasTareaEstado<br/>FiltroIncompletas<br/>ResultadoIncompleta"]
        DS["ReglasEmision<br/>CodigoI2of5<br/>(dominio puro)"]
        IN["EmisionChequeraUseCase<br/>IncompletasChequerasUseCase<br/>ObtenerBorradorImpresionUseCase<br/>ResumenBorradoresLectivoUseCase<br/>ListarBorradoresSedeUseCase<br/>(Puertos de Entrada)"]
        OUT["BorradorChequeraRepository<br/>IncompletasJobRepository<br/>NumeradorChequeraPort<br/>(Puertos de Salida)"]
    end

    subgraph Aplicacion ["Aplicación (Application)"]
        Facade["EmisionChequeraFacade<br/>(implementa el puerto)"]
        FacadeInc["IncompletasChequerasFacade<br/>alta, emisión, consulta y cancelación del job"]
        Borrador["BorradorEmisionService<br/>contexto, borrador, cuotas, política<br/>hereda y repara el arancel de la serie"]
        Emision["EmisionChequeraService<br/>emisión transaccional<br/>valida arancel (SIN_ARANCEL_TIPO)"]
        Completar["CompletarChequerasIncompletasService<br/>padrón, prepararBorrador, emitir"]
        JobSvc["IncompletasJobService<br/>reclamar, registrar tarea, cerrar"]
        Impresion["ObtenerBorradorImpresionUseCaseImpl<br/>snapshot para el sender"]
        Consulta["BorradorConsultaService<br/>resumen por facultad y sede<br/>sede derivada del tipo de chequera"]
        Factory["BorradorFactory<br/>paridad con el legacy"]
        Exc["EmisionException<br/>codigo + mensaje"]
    end

    subgraph Infraestructura ["Infraestructura (Infrastructure)"]
        Ctrl["EmisionChequeraController<br/>/api/tesoreria/core/emision/chequera<br/>alias /api/tesoreria/core/emisionChequera"]
        CtrlInc["IncompletasChequeraController<br/>/api/tesoreria/core/emision/chequera/incompletas<br/>borradores, emision, job, cancelar, pendientes"]
        CtrlCons["BorradorConsultaController<br/>/api/tesoreria/core/emision/chequera/borradores<br/>resumen por lectivo y listado por sede"]
        Handler["EmisionExceptionHandler<br/>404 / 409 / 422 con codigo"]
        DTO["CrearBorradorRequest<br/>ActualizarBorradorRequest<br/>CompletarBorradorRequest<br/>EmitirBorradorRequest<br/>BorradorResponse<br/>BorradorImpresion<br/>FacultadSedeBorradorResponse<br/>IncompletasJobRequest<br/>IncompletasEmisionRequest<br/>IncompletasJobResponse<br/>IncompletasJobDetalleResponse"]
        DtoMap["EmisionDtoMapper<br/>IncompletasDtoMapper"]
        Adp["JpaBorradorChequeraRepositoryAdapter"]
        AdpInc["JpaIncompletasJobRepositoryAdapter"]
        Num["JpaNumeradorChequeraAdapter"]
        Repo["JpaBorradorChequeraRepository<br/>derived queries<br/>incluye consultas por lectivo, facultad y estado"]
        RepoInc["JpaIncompletasJobRepository<br/>JpaIncompletasJobTareaRepository"]
        Ent["BorradorChequeraEntity<br/>BorradorCuotaEntity<br/>IncompletasJobEntity<br/>IncompletasJobTareaEntity"]
        Tabla["chequera_borrador<br/>chequera_borrador_cuota<br/>V423 · V426/V427 (renombre) · V429 (duplicados)"]
        TablaInc["chequera_incompleta_job<br/>chequera_incompleta_job_tarea<br/>V428 (nuevas)"]
        Worker["IncompletasJobWorker<br/>@Scheduled, heartbeat, reencolado, retención"]
        Exec["chequerasIncompletasJobExecutor<br/>1 hilo, cola 1"]
        Job["BorradorRetentionJob<br/>cron 03:30, retención 30 días"]
    end

    subgraph Reuso ["Slices y legacy reutilizados"]
        Slices["ChequeraSerie / ChequeraCuota / ChequeraPago<br/>ChequeraTotal / TipoChequera / ArancelTipo<br/>Baja / Persona / Domicilio / Facultad<br/>Lectivo / Geografica / Setup / PermisoEfectivo"]
        Legacy["ChequeraSerieControlRepository @Lock<br/>ChequeraAlternativa / Debito<br/>LectivoTotal / PlantillaArancel<br/>ChequeraIncompletaService (vw_chequera_incompleta)<br/>PersonaSuspendido / LectivoCuota"]
        Arancel["ArancelTipoService<br/>findAllHabilitados / findByArancelTipoId"]
    end

