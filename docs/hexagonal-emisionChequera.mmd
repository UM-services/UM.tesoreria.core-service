        M["BorradorChequera<br/>BorradorCuota<br/>BorradorImpresion<br/>BorradorSede<br/>EstadoBorrador<br/>ContextoEmision<br/>SolicitudEmision<br/>ResultadoEmision"]
        MI["IncompletasJob<br/>IncompletasJobTarea<br/>IncompletasJobDetalle<br/>IncompletasEtapa<br/>IncompletasJobEstado<br/>IncompletasTareaEstado<br/>FiltroIncompletas<br/>ResultadoIncompleta"]
        MG["GeneracionJob<br/>GeneracionJobTarea<br/>GeneracionJobDetalle<br/>GeneracionEtapa<br/>GeneracionJobEstado<br/>GeneracionTareaEstado<br/>FiltroGeneracion<br/>GeneracionPadronItem<br/>PaginaBorradores<br/>ResultadoGeneracionFila"]
        DS["ReglasEmision<br/>CodigoI2of5<br/>(dominio puro)"]
        IN["EmisionChequeraUseCase<br/>IncompletasChequerasUseCase<br/>GeneracionBorradoresUseCase<br/>ObtenerBorradorImpresionUseCase<br/>ResumenBorradoresLectivoUseCase<br/>ListarBorradoresSedeUseCase<br/>(Puertos de Entrada)"]
        OUT["BorradorChequeraRepository<br/>IncompletasJobRepository<br/>GeneracionJobRepository<br/>NumeradorChequeraPort<br/>(Puertos de Salida)"]
    end

    subgraph Aplicacion ["Aplicación (Application)"]
        Facade["EmisionChequeraFacade<br/>(implementa el puerto)"]
        FacadeInc["IncompletasChequerasFacade<br/>alta, emisión, consulta y cancelación del job"]
        FacadeGen["GeneracionBorradoresFacade<br/>padrón de altas, borradores, emisión<br/>desde el job o directa (envío)"]
        Borrador["BorradorEmisionService<br/>contexto, borrador, cuotas, política<br/>hereda y repara el arancel de la serie"]
        Emision["EmisionChequeraService<br/>emisión transaccional<br/>valida arancel (SIN_ARANCEL_TIPO)"]
        Completar["CompletarChequerasIncompletasService<br/>padrón, prepararBorrador, emitir"]
        GenService["GeneracionBorradoresService<br/>padrón de altas, prepararBorrador, emitir"]
        JobSvc["IncompletasJobService<br/>reclamar, registrar tarea, cerrar"]
        GenJobSvc["GeneracionJobService<br/>reclamar, registrar tarea, cerrar"]
        Impresion["ObtenerBorradorImpresionUseCaseImpl<br/>snapshot para el sender"]
        Consulta["BorradorConsultaService<br/>resumen y listado paginado por sede<br/>sede derivada del tipo de chequera"]
        Factory["BorradorFactory<br/>paridad con el legacy"]
        Exc["EmisionException<br/>codigo + mensaje"]
    end

    subgraph Infraestructura ["Infraestructura (Infrastructure)"]
        Ctrl["EmisionChequeraController<br/>/api/tesoreria/core/emision/chequera<br/>alias /api/tesoreria/core/emisionChequera"]
        CtrlInc["IncompletasChequeraController<br/>/api/tesoreria/core/emision/chequera/incompletas<br/>borradores, emision, job, cancelar, pendientes"]
