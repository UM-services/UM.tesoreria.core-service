title: Arquitectura Hexagonal - Módulo EmisionChequera (v12.6.0)
---
flowchart TD
    subgraph Dominio ["Dominio (Domain)"]
        M["BorradorChequera<br/>BorradorCuota<br/>EstadoBorrador<br/>ContextoEmision<br/>SolicitudEmision<br/>ResultadoEmision"]
        DS["ReglasEmision<br/>CodigoI2of5<br/>(dominio puro)"]
        IN["EmisionChequeraUseCase<br/>(Puerto de Entrada)"]
        OUT["BorradorChequeraRepository<br/>NumeradorChequeraPort<br/>(Puertos de Salida)"]
    end

    subgraph Aplicacion ["Aplicación (Application)"]
        Facade["EmisionChequeraFacade<br/>(implementa el puerto)"]
        Borrador["BorradorEmisionService<br/>contexto, borrador, cuotas, política"]
        Emision["EmisionChequeraService<br/>emisión transaccional"]
        Factory["BorradorFactory<br/>paridad con el legacy"]
        Exc["EmisionException<br/>codigo + mensaje"]
    end

    subgraph Infraestructura ["Infraestructura (Infrastructure)"]
        Ctrl["EmisionChequeraController<br/>/api/tesoreria/core/emision/chequera<br/>alias /api/tesoreria/core/emisionChequera"]
        Handler["EmisionExceptionHandler<br/>409 / 400 con codigo"]
        DTO["CrearBorradorRequest<br/>ActualizarBorradorRequest<br/>CompletarBorradorRequest<br/>EmitirBorradorRequest<br/>BorradorResponse<br/>ContextoEmisionResponse<br/>ResultadoEmisionResponse"]
        DtoMap["EmisionDtoMapper"]
        Adp["JpaBorradorChequeraRepositoryAdapter"]
        Num["JpaNumeradorChequeraAdapter"]
        Repo["JpaBorradorChequeraRepository<br/>derived queries"]
        Ent["BorradorChequeraEntity<br/>BorradorCuotaEntity"]
        Tabla["chequera_borrador<br/>chequera_borrador_cuota<br/>docs/sql/V423"]
        Job["BorradorRetentionJob<br/>cron 03:30, retención 30 días"]
    end

    subgraph Reuso ["Slices y legacy reutilizados"]
        Slices["ChequeraSerie / ChequeraCuota / ChequeraPago<br/>ChequeraTotal / TipoChequera / ArancelTipo<br/>Baja / Persona / Domicilio / Facultad<br/>Setup / PermisoEfectivo"]
        Legacy["ChequeraSerieControlRepository @Lock<br/>ChequeraAlternativa / Debito<br/>LectivoTotal / PlantillaArancel"]
    end

