---
title: Arquitectura Hexagonal - Módulo Rol (v6.3.0)
---
flowchart TD
    subgraph Dominio ["Dominio (Domain)"]
        M["Rol<br/>nombre, descripcion, aplicacion, activo"]
        IN["CreateRolUseCase<br/>GetRolByIdUseCase<br/>GetAllRolesUseCase<br/>UpdateRolUseCase<br/>DeleteRolUseCase"]
        OUT["RolRepository<br/>(Puerto de Salida)"]
    end

    subgraph Aplicacion ["Aplicación (Application)"]
        Svc["RolService"]
        UCs["Create/Get/GetAll/Update/Delete<br/>RolUseCaseImpl"]
        Exc["RolException"]
    end

    subgraph Infraestructura ["Infraestructura (Infrastructure)"]
        Ctrl["RolController<br/>/api/tesoreria/core/rol"]
        DTO["RolRequest<br/>RolResponse"]
        Map["RolDtoMapper<br/>RolMapper"]
        Adp["JpaRolRepositoryAdapter"]
        Ent["RolEntity<br/>tabla rol"]
        Jpa["JpaRolRepository"]
    end

    Ctrl --> Svc
    Ctrl --> Map
    Map --> DTO
    Svc --> IN
