---
title: Arquitectura Hexagonal - Módulo Rol (v12.7.0)
---
flowchart TD
    subgraph Dominio ["Dominio (Domain)"]
        M["Rol<br/>nombre, descripcion, aplicacion, activo"]
        Sem["RolSemilla<br/>permisos exactos y comodines"]
        Res["SyncRolesResultado"]
        IN["CreateRolUseCase<br/>GetRolByIdUseCase<br/>GetAllRolesUseCase<br/>UpdateRolUseCase<br/>DeleteRolUseCase<br/>SyncRolesUseCase<br/>(Puertos de Entrada)"]
        OUT["RolRepository<br/>findByAplicacionAndNombre<br/>(Puerto de Salida)"]
    end

    subgraph Aplicacion ["Aplicación (Application)"]
        Svc["RolService"]
        Sync["SyncRolesUseCaseImpl<br/>crea/actualiza y reconcilia rol_permiso"]
        UCs["Create/Get/GetAll/Update/Delete<br/>RolUseCaseImpl"]
        Exc["RolException<br/>RolManifestException"]
    end

    subgraph Infraestructura ["Infraestructura (Infrastructure)"]
        Ctrl["RolController<br/>/api/tesoreria/core/rol"]
        DTO["RolRequest<br/>RolResponse"]
        Map["RolDtoMapper<br/>RolMapper"]
        Adp["JpaRolRepositoryAdapter"]
        Ent["RolEntity<br/>tabla rol"]
        Jpa["JpaRolRepository<br/>derived queries"]
        Loader["RolManifestLoader<br/>roles.yaml"]
        Runner["RolesManifestSyncRunner<br/>@Order(2)"]
        Sql["docs/sql/V424__roles_semilla.sql<br/>camino offline idempotente"]
    end

    subgraph Otros ["Slices consumidos"]
        Perm["GetAllPermisosUseCase<br/>(usuarios.permiso)"]
        RolePerm["RolPermisoRepository<br/>(usuarios.rolPermiso)"]
    end

