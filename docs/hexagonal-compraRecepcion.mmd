        Map["CompraRecepcionDtoMapper<br/>CompraRecepcionMapper"]
        Adp["JpaCompraRecepcionRepositoryAdapter<br/>CompraRecepcionSecuenciaJdbcAdapter<br/>CompraRecepcionPedidoJdbcAdapter"]
        Ent["CompraRecepcionEntity (compra_recepcion)<br/>CompraRecepcionItemEntity<br/>(compra_recepcion_item)"]
        Jpa["JpaCompraRecepcionRepository<br/>JpaCompraRecepcionItemRepository"]
    end

    subgraph CrossSlice ["Composición con otros slices"]
        Form["CompraFormalizacionService<br/>(detalle contratado de la OC)"]
        Ped["CompraPedidoService<br/>(RECEPCION_PARCIAL / RECEPCIONADO)"]
    end

