        OUT["CompraRecepcionRepository<br/>CompraRecepcionSecuenciaPort<br/>CompraRecepcionPedidoPort<br/>(Puertos de Salida)"]
    end

    subgraph Aplicacion ["Aplicación (Application)"]
        Svc["CompraRecepcionService<br/>@Transactional (registrar: saldo +<br/>avance del pedido; cerrar manual)"]
        Calc["CalculadoraSaldosRecepcion<br/>(saldo derivado, NO_CONFORME no cubre)"]
        UCs["*UseCaseImpl (3)"]
        Exc["CompraRecepcionException"]
    end

    subgraph Infraestructura ["Infraestructura (Infrastructure)"]
        Ctrl["CompraRecepcionController<br/>/api/tesoreria/core/compraRecepcion"]
