---
title: Arquitectura Hexagonal - Módulo Cuenta (v9.3.0)
---
flowchart TD
    subgraph Dominio ["Dominio (Domain)"]
        C["Cuenta"]
        CJ["CuentaJerarquia<br/>Validación, padre, ancestros, grados y rango"]
        CR["CuentaRepository<br/>Puerto de salida"]
        CH["CuentaHistorialPort<br/>Puerto de salida"]
        IP["Puertos de entrada<br/>Alta, edición, baja, consulta y recálculo"]
    end
    subgraph Aplicacion ["Aplicación (Application)"]
        CS["CuentaService"]
        UC["Casos de uso<br/>TransactionOperations para escrituras"]
        EX["CuentaConflictoException"]
    end
    subgraph Infraestructura ["Infraestructura (Infrastructure)"]
        CC["CuentaController<br/>Alias corto y largo; 409 con JSON"]
        DTO["CuentaRequest / CuentaResponse<br/>CuentaErrorResponse"]
        JPA["JpaCuentaRepositoryAdapter<br/>persist para alta; entidades gestionadas para cambios"]
        ENT["CuentaEntity<br/>DynamicUpdate"]
        JR["JpaCuentaRepository<br/>Métodos derivados y PESSIMISTIC_WRITE"]
        MOV["CuentaMovimientoReferenciaEntity<br/>movcon, solo lectura"]
        MR["CuentaMovimientoReferenciaRepository<br/>existsByNumeroCuentaBetween"]
        HA["CuentaHistorialAdapter<br/>Copias planas del estado"]
        CSS["CuentaSearchService<br/>Dependencia legacy preexistente"]
    end
    subgraph Externo ["Externo (External)"]
        HIST["RegistrarEscrituraHistorialUseCase<br/>Puerto público de historial 404"]
        LEG["ContabilidadService<br/>Balance: delega recálculo y limpieza de nombres"]
    end
    CC --> DTO
    CC --> CS
    CS --> IP
    UC -. implementa .-> IP
    UC --> CJ
    UC --> C
    UC --> CR
    UC --> CH
    UC --> EX
    JPA -. implementa .-> CR
    JPA --> JR
    JR --> ENT
    JPA --> CJ
    JPA --> MR
    MR --> MOV
    JPA --> CSS
    HA -. implementa .-> CH
    HA --> HIST
    LEG --> CS
