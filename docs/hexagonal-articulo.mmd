---
title: Arquitectura Hexagonal - Módulo Artículo (v7.0.0)
---

flowchart TD
    subgraph Dominio ["Dominio (Domain)"]
        A[Articulo / ArticuloSearch<br/>Modelo de Dominio]
        RA[ReferenciaArticulo<br/>tabla + cantidad]
        AR[ArticuloRepository<br/>Puerto de Salida]
        RR[ReferenciasArticuloRepository<br/>Puerto de Salida]
        IN[Create/Update/Delete/GetById/GetAll/<br/>GetNew/GetPaginated/Search ArticuloUseCase<br/>Puertos de Entrada]
    end

    subgraph Aplicacion ["Aplicación (Application)"]
        AS[ArticuloService<br/>sin transacción: un reintento ante interbloqueo]
        CR[CreateArticuloUseCaseImpl]
        UP[UpdateArticuloUseCaseImpl]
        DE[DeleteArticuloUseCaseImpl]
        RD[Get* / Search* UseCaseImpl<br/>lecturas]
        REG[ArticuloReglas<br/>validación y escala de columnas]
        EST[ArticuloEstado<br/>foto para el historial]
        EX[ArticuloException 404<br/>ArticuloValidationException 400<br/>ArticuloConflictException 409]
    end

    subgraph Infraestructura ["Infraestructura (Infrastructure)"]
        AC[ArticuloController<br/>ProblemDetail con codigo/campo/referencias]
        JPA[JpaArticuloRepositoryAdapter<br/>persist + flush, SELECT ... FOR UPDATE nativo]
        RES[ArticuloRestricciones<br/>traduce 1062/1366/1451/1452/1205/1213]
        REF[JpaReferenciasArticuloAdapter<br/>COUNT entrega_detalle, movprov_detallefactura]
        ENT[ArticuloEntity / ArticuloMapper]
    end

    subgraph OtrosSlices ["Otros slices (puertos públicos)"]
        CTA[contable.cuenta<br/>GetCuentaByNumeroCuentaUseCase]
        DUA[ubicacionArticulo<br/>DeleteUbicacionArticulosByArticuloUseCase]
        HIS[gestion.escrituraHistorial<br/>RegistrarEscrituraHistorialUseCase]
    end

    AC -->|usa| AS
    AS -->|depende| IN
    CR -.->|implementa| IN
    UP -.->|implementa| IN
    DE -.->|implementa| IN
    RD -.->|implementa| IN

    CR -->|valida| REG
    UP -->|valida| REG
    CR -->|existe la cuenta| CTA
    UP -->|existe la cuenta| CTA
    CR -->|ALTA| HIS
    UP -->|EDICION si cambió| HIS
    DE -->|BAJA| HIS
    CR & UP & DE -->|foto| EST

    DE -->|1. bloquea el artículo| AR
    DE -->|2. cuenta referencias| RR
    DE -->|3. borra vínculos| DUA
    DE -->|4. borra el artículo| AR
    CR -->|usa| AR
    UP -->|bloquea y guarda| AR
    RD -->|usa| AR

    JPA -->|implementa| AR
    REF -->|implementa| RR
    JPA -->|traduce errores| RES
    JPA -->|gestiona| ENT
    RR -->|devuelve| RA
    RES -->|lanza| EX

