---
title: Arquitectura Hexagonal - Módulo UbicacionArticulo (v8.0.0)
---

flowchart TD
    subgraph Dominio ["Dominio (Domain)"]
        UA[UbicacionArticulo<br/>Modelo de Dominio]
        AG[AsignacionGuardada<br/>anterior + guardada]
        UAR[UbicacionArticuloRepository<br/>Puerto de Salida]
        DUA[DeleteUbicacionArticulosByArticuloUseCase<br/>Puerto de Entrada público]
    end

    subgraph Aplicacion ["Aplicación (Application)"]
        UAS[UbicacionArticuloService<br/>sin transacción: un reintento ante conflicto reintentable]
        SV[SaveUbicacionArticuloUseCaseImpl<br/>valida y registra ALTA/EDICION]
        DV[DeleteUbicacionArticulosByArticuloUseCaseImpl<br/>MANDATORY: dentro de la baja del artículo]
        RD[GetAll / Get / GetByArticulo UseCaseImpl]
        EST[UbicacionArticuloEstado<br/>foto para el historial]
        EX[UbicacionArticuloException 404<br/>UbicacionArticuloValidationException 400<br/>UbicacionArticuloConflictException 409]
    end

    subgraph Infraestructura ["Infraestructura (Infrastructure)"]
        UAC[UbicacionArticuloController<br/>ProblemDetail con codigo/campo]
        JPA[JpaUbicacionArticuloRepositoryAdapter<br/>upsert por par, bloqueo por clave primaria<br/>revalida el par bajo bloqueo]
        RES[UbicacionArticuloRestricciones<br/>traduce 1062/1452/1205/1213]
        ENT[UbicacionArticuloEntity / Mapper]
    end

    subgraph OtrosSlices ["Otros slices (puertos públicos)"]
        UB[dependencias.ubicacion<br/>GetUbicacionByIdUseCase]
        AR[compras.articulo<br/>GetArticuloByIdUseCase]
        CTA[contable.cuenta<br/>GetCuentaByNumeroCuentaUseCase]
        HIS[gestion.escrituraHistorial<br/>RegistrarEscrituraHistorialUseCase]
        DEA[compras.articulo<br/>DeleteArticuloUseCaseImpl]
    end

    UAC -->|usa| UAS
    UAS -->|depende| SV
    UAS -->|depende| RD
    SV -->|existe la ubicación| UB
    SV -->|existe el artículo| AR
    SV -->|existe la cuenta| CTA
    SV -->|guarda| UAR
    UAR -->|devuelve| AG
    SV -->|ALTA / EDICION si cambió| HIS
    DEA -->|borra los vínculos| DUA
    DV -.->|implementa| DUA
    DV -->|bloquea y borra| UAR
    DV -->|BAJA por vínculo| HIS
    SV & DV -->|foto| EST
    RD -->|usa| UAR

    JPA -->|implementa| UAR
    JPA -->|traduce errores| RES
    JPA -->|gestiona| ENT
    RES -->|lanza| EX

